generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./app.db"
}

model templates {
  id   String @id @default(uuid())
  name String

  templateCode String? @map("template_code")

  department String?
  category   String?

  chart Json?

  chartX String? @map("chart_x")
  chartY String? @map("chart_y")

  description String?

  fields Json @default("[]")

  createdBy String? @map("created_by")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@map("templates")
}
